# =============================================================================
# EarningsPulse — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- App URLs (local development) ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Backend ---
ENVIRONMENT=development
DEBUG=false

# --- Production (Railway / Render + Vercel) ---
# ENVIRONMENT=production
# FRONTEND_URL=https://your-app.vercel.app
# NEXT_PUBLIC_BACKEND_URL=https://your-api.up.railway.app
# CORS_ORIGINS=["https://your-app.vercel.app"]   # optional; FRONTEND_URL is auto-merged
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app       # optional; prefer an exact origin in production

# --- LLM (required for live playbook generation) ---
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o
# Google/Gemma fallback when OpenAI fails (e.g. exhausted credits)
GOOGLE_API_KEY=your-google-ai-studio-key-here
GOOGLE_LLM_MODEL=gemma-4-31b-it
# ANTHROPIC_API_KEY=sk-ant-your-key-here   # Not wired yet

# --- Hackathon Partners ---
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- Market Data ---
FINNHUB_API_KEY=your-finnhub-key-here

# --- SEC EDGAR (required User-Agent per SEC fair access policy) ---
SEC_USER_AGENT=EarningsPulse your-email@example.com

# --- PRISM (Block Convey). Required for the hackathon demo. ---
PRISM_REQUIRED=true
PRISM_API_KEY=
PRISM_PROJECT_ID=de776c8e-0af3-4e09-9e93-15bc99b24c22
PRISM_HOST=https://prism-api-prod.up.railway.app
# Set PRISM_API_KEY in your private env. Use PRISM_REQUIRED=false for offline work.

# --- Optional ---
# REACTION_HISTORY_LIMIT=40
# MONTE_CARLO_SIMULATIONS=1000
# VALIDATION_TRAIN_RATIO=0.7
# REDIS_URL=redis://localhost:6379
